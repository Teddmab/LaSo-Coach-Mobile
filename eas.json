{
  "cli": {
    "version": ">= 5.9.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.19.4",
      "ios": {
        "env": {
          "RCT_USE_RN_DEP": "0"
        }
      }
    },
    "test": {
      "distribution": "internal",
      "node": "20.19.4",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.19.4",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "env": {
          "RCT_USE_RN_DEP": "0",
          "FORCE_PREBUILD": "true",
          "SENTRY_DISABLE_AUTO_UPLOAD": "true"
        }
      }
    },
    "production": {
      "node": "20.19.4",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "env": {
          "RCT_USE_RN_DEP": "0",
          "FORCE_PREBUILD": "true",
          "SENTRY_DISABLE_AUTO_UPLOAD": "true"
        }
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
} 