{
  "cli": {
    "version": ">= 5.9.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.19.4",
      "ios": {
        "env": {
          "RCT_USE_RN_DEP": "0",
          "IOS_APS_ENVIRONMENT": "development",
          "ONESIGNAL_PLUGIN_MODE": "development"
        }
      },
      "android": {
        "env": {
          "ANDROID_NDK_VERSION": "27.1.12297006"
        }
      }
    },
    "test": {
      "distribution": "internal",
      "node": "20.19.4",
      "android": {
        "buildType": "apk",
        "env": {
          "ANDROID_NDK_VERSION": "27.1.12297006"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "20.19.4",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "env": {
          "ANDROID_NDK_VERSION": "27.1.12297006"
        }
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "env": {
          "RCT_USE_RN_DEP": "0",
          "FORCE_PREBUILD": "true",
          "SENTRY_DISABLE_AUTO_UPLOAD": "true",
          "IOS_APS_ENVIRONMENT": "production",
          "ONESIGNAL_PLUGIN_MODE": "production"
        }
      }
    },
    "production": {
      "node": "20.19.4",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "env": {
          "RCT_USE_RN_DEP": "0",
          "FORCE_PREBUILD": "true",
          "SENTRY_DISABLE_AUTO_UPLOAD": "true",
          "IOS_APS_ENVIRONMENT": "production",
          "ONESIGNAL_PLUGIN_MODE": "production"
        }
      },
      "android": {
        "buildType": "app-bundle",
        "env": {
          "ANDROID_NDK_VERSION": "27.1.12297006"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
} 